# GramWeather AI Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External Weather Sources
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1

# Simulation & Demo Controls
SIMULATE_IOT_SENSORS=true
SIMULATE_COMMUNITY_REPORTS=true
DEFAULT_VILLAGE_ID=khanna

# Authentication Security (JWT)
JWT_SECRET=your_jwt_secret_key_here
